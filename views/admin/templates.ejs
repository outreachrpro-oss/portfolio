<%- include('../partials/header') %>

<div class="admin-light" style="min-height: 100vh;">
  <div class="breadcrumb">
    <div class="container">
      <div class="breadcrumb-content">
        <div class="row align-items-center">
          <div class="col-lg-8">
            <h1>Manage Templates</h1>
            <p class="wv-mt-20">Add, edit, publish, or delete website templates.</p>
          </div>
          <div class="col-lg-4 flex-lg-end">
            <a href="/admin/templates/add" class="theme-btn with-icon">
              Add New Template <i class="fa-light fa-plus"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="section-margin" style="padding-top: 0;">
    <div class="container">
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Thumbnail</th>
              <th>Name</th>
              <th>Technology</th>
              <th>Category</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% templates.forEach(function(template) { %>
              <tr>
                <td>
                  <img src="<%= encodeURI(template.thumbnail || '') %>" alt="" style="width: 80px; height: 55px; object-fit: cover; border-radius: 8px;">
                </td>
                <td><%= template.title %></td>
                <td><%= template.technology %></td>
                <td><%= template.category %></td>
                <td>
                  <% if (template.published) { %>
                    <span class="badge bg-success">Published</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Draft</span>
                  <% } %>
                </td>
                <td>
                  <a href="/projects-details.html?slug=<%= template.slug %>" class="btn btn-sm btn-outline-dark" target="_blank">View</a>
                  <a href="/admin/templates/edit/<%= template.id %>" class="btn btn-sm btn-outline-primary">Edit</a>
                  <form action="/admin/templates/delete/<%= template.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this template?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
            <% if (!templates.length) { %>
              <tr>
                <td colspan="6" class="text-center">No templates found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

<%- include('../partials/footer') %>
