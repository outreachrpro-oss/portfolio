<%- include('../partials/header') %>

<div class="admin-light" style="min-height: 100vh;">
  <div class="container" style="padding-top: 120px; padding-bottom: 40px;">
    <h1 style="color:#111;"><%= template ? 'Edit' : 'Add' %> Template</h1>
    <p style="color:#666;">Technology &amp; Category free text hain — kuch bhi type kar sakte ho.</p>
  </div>

  <section style="padding-bottom: 80px;">
    <div class="container">
      <form id="templateForm">
        <input type="hidden" name="id" value="<%= template ? template.id : '' %>">

        <div class="row g-4">
          <div class="col-lg-8">
            <div class="admin-card mb-4">
              <h4 class="mb-4">Template Information</h4>

              <div class="mb-3">
                <label class="admin-label">Template Name</label>
                <input type="text" name="title" class="admin-input" value="<%= template ? template.title : '' %>" required placeholder="e.g. Modern SaaS Website">
              </div>

              <div class="row mb-3">
                <div class="col-md-6">
                  <label class="admin-label">Technology</label>
                  <input type="text" name="technology" class="admin-input" list="tech-suggestions" value="<%= template ? template.technology : '' %>" placeholder="e.g. HTML, React" required>
                  <datalist id="tech-suggestions">
                    <option value="HTML"></option>
                    <option value="React"></option>
                  </datalist>
                </div>
                <div class="col-md-6">
                  <label class="admin-label">Category</label>
                  <input type="text" name="category" class="admin-input" list="category-suggestions" value="<%= template ? template.category : '' %>" placeholder="e.g. Business, SaaS" required>
                  <datalist id="category-suggestions">
                    <option value="Business"></option>
                    <option value="SaaS"></option>
                  </datalist>
                </div>
              </div>

              <div class="mb-3">
                <label class="admin-label">Short Description</label>
                <textarea name="shortDescription" class="admin-textarea" rows="2"><%= template ? template.shortDescription : '' %></textarea>
              </div>

              <div class="mb-3">
                <label class="admin-label">Full Description</label>
                <textarea name="description" class="admin-textarea" rows="5"><%= template ? template.description : '' %></textarea>
              </div>
            </div>

            <div class="admin-card">
              <h4 class="mb-4">Details</h4>
              <div class="mb-3">
                <label class="admin-label">Features (one per line)</label>
                <textarea name="features" class="admin-textarea" rows="4"><%= template && template.features ? template.features.join('\n') : '' %></textarea>
              </div>
              <div class="mb-3">
                <label class="admin-label">Pages Included (one per line)</label>
                <textarea name="pagesIncluded" class="admin-textarea" rows="4"><%= template && template.pagesIncluded ? template.pagesIncluded.join('\n') : '' %></textarea>
              </div>
              <div class="mb-3">
                <label class="admin-label">Technologies Used (one per line)</label>
                <textarea name="technologiesUsed" class="admin-textarea" rows="4"><%= template && template.technologiesUsed ? template.technologiesUsed.join('\n') : '' %></textarea>
              </div>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="admin-card mb-4">
              <h4 class="mb-4">Links &amp; Price</h4>
              <div class="mb-3">
                <label class="admin-label">Live Demo URL</label>
                <input type="url" name="liveDemoUrl" class="admin-input" value="<%= template ? template.liveDemoUrl : '' %>" placeholder="https://...">
              </div>
              <div class="mb-3">
                <label class="admin-label">Purchase URL (optional)</label>
                <input type="url" name="purchaseUrl" class="admin-input" value="<%= template ? template.purchaseUrl : '' %>">
              </div>
              <div class="mb-3">
                <label class="admin-label">Price (optional)</label>
                <input type="text" name="price" class="admin-input" value="<%= template ? template.price : '' %>" placeholder="e.g. $49">
              </div>
            </div>

            <div class="admin-card mb-4">
              <h4 class="mb-4">Media</h4>
              <div class="mb-3">
                <label class="admin-label">Main Thumbnail</label>
                <input type="file" id="thumbnailInput" class="admin-input" accept="image/*" <%= template ? '' : 'required' %>>
                <% if (template && template.thumbnail) { %>
                  <div class="mt-2 text-center">
                    <img src="<%= encodeURI(template.thumbnail) %>" alt="" style="max-width: 100%; border-radius: 10px;">
                  </div>
                <% } %>
              </div>
              <div class="mb-3">
                <label class="admin-label">Gallery Images (Up to 5)</label>
                <input type="file" id="galleryInput" class="admin-input" accept="image/*" multiple>
              </div>
            </div>

            <div class="admin-card">
              <h4 class="mb-4">Save</h4>
              <div id="saveError" style="display:none;color:#b91c1c;margin-bottom:12px;font-size:14px;"></div>
              <div class="admin-actions">
                <button type="button" class="btn-draft" data-status="draft">Save Draft</button>
                <button type="button" class="btn-publish" data-status="published">Publish Template</button>
              </div>
              <p class="mt-3 mb-0" style="color:#6b7280;font-size:13px;" id="saveStatus"></p>
              <p class="mt-2 mb-0" style="color:#6b7280;font-size:13px;">
                Publish recommended. Portfolio pe saare saved projects show hote hain.
              </p>
            </div>
          </div>
        </div>
      </form>
    </div>
  </section>
</div>

<script>
(function () {
  function readFileAsDataURL(file) {
    return new Promise(function (resolve, reject) {
      var reader = new FileReader();
      reader.onload = function () { resolve(reader.result); };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  async function buildPayload(status) {
    var form = document.getElementById('templateForm');
    var fd = new FormData(form);
    var payload = {
      id: fd.get('id') || '',
      title: fd.get('title') || '',
      technology: fd.get('technology') || '',
      category: fd.get('category') || '',
      shortDescription: fd.get('shortDescription') || '',
      description: fd.get('description') || '',
      liveDemoUrl: fd.get('liveDemoUrl') || '',
      purchaseUrl: fd.get('purchaseUrl') || '',
      price: fd.get('price') || '',
      features: fd.get('features') || '',
      pagesIncluded: fd.get('pagesIncluded') || '',
      technologiesUsed: fd.get('technologiesUsed') || '',
      status: status,
      thumbnailData: '',
      galleryData: []
    };

    var thumb = document.getElementById('thumbnailInput').files[0];
    if (thumb) {
      payload.thumbnailData = await readFileAsDataURL(thumb);
    }

    var galleryFiles = Array.prototype.slice.call(document.getElementById('galleryInput').files || []).slice(0, 5);
    for (var i = 0; i < galleryFiles.length; i++) {
      payload.galleryData.push(await readFileAsDataURL(galleryFiles[i]));
    }

    return payload;
  }

  async function save(status) {
    var errEl = document.getElementById('saveError');
    var statusEl = document.getElementById('saveStatus');
    errEl.style.display = 'none';
    statusEl.textContent = 'Saving...';

    try {
      var payload = await buildPayload(status);
      if (!payload.title.trim()) throw new Error('Template name is required');
      if (!payload.id && !payload.thumbnailData) throw new Error('Main thumbnail is required');

      var res = await fetch('/admin/templates/save-json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      var data = await res.json().catch(function () { return {}; });
      if (!res.ok || !data.ok) {
        throw new Error(data.error || ('Save failed (' + res.status + ')'));
      }
      statusEl.textContent = 'Saved! Redirecting...';
      window.location.href = '/admin/templates';
    } catch (err) {
      statusEl.textContent = '';
      errEl.style.display = 'block';
      errEl.textContent = err.message || 'Failed to save template';
    }
  }

  document.querySelectorAll('[data-status]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      save(btn.getAttribute('data-status'));
    });
  });
})();
</script>

<%- include('../partials/footer') %>
